{
  "version": 2,
  "builds": [
    {
      "src": "apps/demo/package.json",
      "use": "@vercel/next"
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile && pnpm run build",
  "outputDirectory": "apps/demo/.next",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
